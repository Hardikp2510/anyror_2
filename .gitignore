# ==========================================
# TitleNode AnyRoR SaaS .gitignore
# ==========================================

# Sensitive Environment Configurations (NEVER commit secrets!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env.local

# Python Virtual Environments & Packages
venv/
.venv/
env/
ENV/
backend/venv/
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*.class
.pytest_cache/
.coverage
htmlcov/

# Node.js & Next.js Build Outputs
node_modules/
frontend/node_modules/
.next/
frontend/.next/
out/
frontend/out/
*.tsbuildinfo
frontend/tsconfig.tsbuildinfo

# Logs & Debug
logs/
backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Temporary scratch scripts
backend/sample_entry.json
backend/check_sample.py
chrome_crawler_profile/
backend/output/
output/
